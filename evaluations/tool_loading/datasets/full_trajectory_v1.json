    {
      "case_id": "store-escaped-unicode",
      "scenario": "escaping_unicode",
      "input": "Persist this text exactly, including newlines, quotes, Unicode, and the backslash path; attach labels unicode and escaping:\nLine one\nHe said: \"工具 ready\".\nPath C:\\tmp\\agent",
      "reference_query": "persist exact text with labels",
      "relevant_tools": [
        "store_text_blob"
      ],
      "target_tool": "store_text_blob",
      "expected_arguments": {
        "text": "Line one\nHe said: \"工具 ready\".\nPath C:\\tmp\\agent",
        "labels": [
          "unicode",
          "escaping"
        ]
      },
      "expected_output": {
        "characters": 47,
        "lines": 3,
        "labels": [
          "unicode",
          "escaping"
        ],
        "sha256": "0267703666ddd18dce588609c4c7153f0adc980b603b037f5f834d4170f9a39e"
      }
    },
