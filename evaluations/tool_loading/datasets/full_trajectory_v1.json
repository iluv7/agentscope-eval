        "tree": {
          "label": "root",
          "children": [
            {
              "label": "left",
              "children": [
                {
                  "label": "leaf",
                  "children": []
                }
              ]
            },
            {
              "label": "right",
              "children": []
            }
          ]
        }
      },
      "expected_output": {
        "labels": [
          "root",
          "left",
          "leaf",
          "right"
        ],
        "node_count": 4,
        "max_depth": 3
      }
    },
